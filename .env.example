# Public site URL used as the base domain for scannable QR payloads and share links
# Avoids localhost URLs when codes are printed or shared in production
VITE_PUBLIC_SITE_URL="https://gorakhpurfoodguide.in"

# Supabase PostgreSQL Database Configuration
# Obtain these credentials from your Supabase Project:
# Supabase Dashboard -> Project Settings -> API -> Project URL & Project API Keys (anon / public)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"
