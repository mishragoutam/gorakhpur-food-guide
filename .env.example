# Public site URL used as the base domain for scannable QR payloads and share links
# Leave empty to automatically use your live deployment origin (e.g. on Vercel)
VITE_PUBLIC_SITE_URL=""

# Supabase PostgreSQL Database Configuration
# Obtain these credentials from your Supabase Project:
# Supabase Dashboard -> Project Settings -> API -> Project URL & Project API Keys (anon / public)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"
